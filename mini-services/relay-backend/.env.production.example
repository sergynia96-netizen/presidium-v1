# Relay Backend - Production Environment Variables
# Copy this to .env.production in mini-services/relay-backend

# Database (PostgreSQL for production)
DATABASE_URL="postgresql://relay:changeme_relay_password@db:5432/relay?schema=public"

# Server
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET="your-relay-jwt-secret-here"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Redis (required for distributed sessions)
REDIS_URL="redis://redis:6379"
REDIS_CLUSTER_NODES=""
RELAY_NODE_ID=""
RELAY_SESSION_TTL_MS="120000"
