# ═══════════════════════════════════════════════════════════
#  Presidium Infrastructure — Environment Variables
#  Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=presidium
POSTGRES_USER=presidium
POSTGRES_PASSWORD=          # required, generate a strong password
POSTGRES_PORT=5432

# ── Valkey (Redis-compatible) ──────────────────────────────
VALKEY_PASSWORD=            # required
VALKEY_PORT=6379

# ── MinIO ──────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=        # required, min 8 chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Coturn (TURN/STUN) ────────────────────────────────────
COTURN_USER=presidium
COTURN_PASSWORD=            # required
COTURN_REALM=presidium.turn
COTURN_EXTERNAL_IP=         # required, your public IP

# ── Prometheus ─────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Grafana ────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=           # required
GRAFANA_PORT=3002

# ── Nginx ──────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=presidium.example.com
